<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="x-apple-disable-message-reformatting" />

        <title>Password Changed - PH Healthcare System</title>

        <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                background-color: #f1f5f9;
                font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                -webkit-font-smoothing: antialiased;
            }

            table {
                border-spacing: 0;
                border-collapse: collapse;
            }

            img {
                border: 0;
                max-width: 100%;
                height: auto;
            }

            @media only screen and (max-width: 640px) {
                .email-wrapper {
                    padding: 20px 10px !important;
                }

                .email-container {
                    width: 100% !important;
                    max-width: 100% !important;
                    border-radius: 16px !important;
                }

                .header {
                    padding: 32px 20px 30px !important;
                }

                .header-title {
                    font-size: 24px !important;
                    line-height: 1.3 !important;
                }

                .header-subtitle {
                    font-size: 14px !important;
                }

                .header-icon {
                    width: 58px !important;
                    height: 58px !important;
                    line-height: 58px !important;
                    font-size: 28px !important;
                    margin-bottom: 16px !important;
                }

                .content {
                    padding: 30px 20px !important;
                }

                .content-title {
                    font-size: 22px !important;
                    line-height: 1.4 !important;
                }

                .content-text {
                    font-size: 15px !important;
                    line-height: 1.7 !important;
                }

                .success-box {
                    padding: 22px 16px !important;
                }

                .success-title {
                    font-size: 17px !important;
                }

                .notice-box {
                    padding: 16px !important;
                }

                .footer {
                    padding: 22px 16px !important;
                }
            }

            @media only screen and (max-width: 400px) {
                .email-wrapper {
                    padding: 10px 5px !important;
                }

                .email-container {
                    border-radius: 12px !important;
                }

                .header {
                    padding: 28px 16px !important;
                }

                .header-title {
                    font-size: 21px !important;
                }

                .content {
                    padding: 25px 16px !important;
                }

                .content-title {
                    font-size: 20px !important;
                }

                .content-text {
                    font-size: 14px !important;
                }

                .success-box {
                    padding: 20px 14px !important;
                }
            }
        </style>
    </head>

    <body>
        <!-- Full Page Background -->
        <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 100%; background-color: #f1f5f9"
        >
            <tr>
                <td
                    class="email-wrapper"
                    align="center"
                    style="padding: 40px 15px"
                >
                    <!-- Main Container -->
                    <table
                        role="presentation"
                        class="email-container"
                        width="620"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="
                            width: 100%;
                            max-width: 620px;
                            background-color: #ffffff;
                            border: 1px solid #e2e8f0;
                            border-radius: 20px;
                            overflow: hidden;
                            box-shadow: 0 12px 35px rgba(15, 23, 42, 0.12);
                        "
                    >
                        <!-- Header -->
                        <tr>
                            <td
                                class="header"
                                align="center"
                                style="
                                    padding: 42px 30px 38px;
                                    background-color: #0284c7;
                                    background-image: linear-gradient(
                                        135deg,
                                        #0284c7 0%,
                                        #0d9488 50%,
                                        #059669 100%
                                    );
                                    color: #ffffff;
                                "
                            >
                                <!-- Security Shield / Check Icon -->
                                <div
                                    class="header-icon"
                                    style="
                                        width: 64px;
                                        height: 64px;
                                        line-height: 64px;
                                        margin: 0 auto 18px;
                                        background-color: rgba(
                                            255,
                                            255,
                                            255,
                                            0.2
                                        );
                                        border: 2px solid
                                            rgba(255, 255, 255, 0.4);
                                        border-radius: 50%;
                                        font-size: 30px;
                                        font-weight: bold;
                                        color: #ffffff;
                                    "
                                >
                                    🔒
                                </div>

                                <h1
                                    class="header-title"
                                    style="
                                        margin: 0;
                                        font-size: 28px;
                                        line-height: 1.3;
                                        font-weight: 700;
                                        letter-spacing: -0.5px;
                                        color: #ffffff;
                                    "
                                >
                                    Password Changed
                                </h1>

                                <p
                                    class="header-subtitle"
                                    style="
                                        margin: 10px 0 0;
                                        font-size: 15px;
                                        line-height: 1.6;
                                        color: rgba(255, 255, 255, 0.9);
                                    "
                                >
                                    Your PH Healthcare System account
                                    credentials have been updated
                                </p>
                            </td>
                        </tr>

                        <!-- Content -->
                        <tr>
                            <td
                                class="content"
                                style="padding: 42px 42px 35px; color: #334155"
                            >
                                <h2
                                    class="content-title"
                                    style="
                                        margin: 0 0 18px;
                                        color: #0f172a;
                                        font-size: 24px;
                                        line-height: 1.4;
                                        font-weight: 700;
                                    "
                                >
                                    Hello, <%= name %>!
                                </h2>

                                <p
                                    class="content-text"
                                    style="
                                        margin: 0 0 16px;
                                        font-size: 16px;
                                        line-height: 1.8;
                                        color: #475569;
                                    "
                                >
                                    This email confirms that the password for
                                    your
                                    <strong style="color: #0f172a">
                                        PH Healthcare System
                                    </strong>
                                    account was recently changed.
                                </p>

                                <!-- Success Details Box -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        margin: 28px 0;
                                        background-color: #f0fdf4;
                                        background-image: linear-gradient(
                                            135deg,
                                            #f0fdf4 0%,
                                            #f0fdfa 100%
                                        );
                                        border: 1px solid #bbf7d0;
                                        border-radius: 16px;
                                    "
                                >
                                    <tr>
                                        <td
                                            class="success-box"
                                            align="center"
                                            style="padding: 22px"
                                        >
                                            <div
                                                style="
                                                    width: 52px;
                                                    height: 52px;
                                                    line-height: 52px;
                                                    margin: 0 auto 12px;
                                                    border-radius: 50%;
                                                    background-color: #16a34a;
                                                    color: #ffffff;
                                                    font-size: 24px;
                                                    font-weight: bold;
                                                "
                                            >
                                                ✓
                                            </div>

                                            <h3
                                                class="success-title"
                                                style="
                                                    margin: 0 0 8px;
                                                    font-size: 18px;
                                                    line-height: 1.4;
                                                    color: #15803d;
                                                "
                                            >
                                                Password Change Confirmed
                                            </h3>

                                            <p
                                                class="content-text"
                                                style="
                                                    margin: 0;
                                                    font-size: 14px;
                                                    line-height: 1.6;
                                                    color: #166534;
                                                "
                                            >
                                                Your new password is now active
                                                and ready to use for future
                                                logins.
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Security Notice & Warning -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        margin-bottom: 28px;
                                        background-color: #fff7ed;
                                        border: 1px solid #fed7aa;
                                        border-radius: 12px;
                                    "
                                >
                                    <tr>
                                        <td
                                            class="notice-box"
                                            style="padding: 18px"
                                        >
                                            <p
                                                class="content-text"
                                                style="
                                                    margin: 0;
                                                    font-size: 14px;
                                                    line-height: 1.7;
                                                    color: #9a3412;
                                                "
                                            >
                                                <strong>
                                                    ⚠️ Didn't change your
                                                    password?
                                                </strong>

                                                <br />

                                                If you did not make this change
                                                yourself, your account may be
                                                compromised. Please reset your
                                                password immediately or contact
                                                our security team at
                                                <a
                                                    href="mailto:security@ph-healthcare.com"
                                                    style="
                                                        color: #c2410c;
                                                        font-weight: 600;
                                                        text-decoration: underline;
                                                    "
                                                    >security@ph-healthcare.com</a
                                                >.
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <p
                                    class="content-text"
                                    style="
                                        margin: 0;
                                        font-size: 15px;
                                        line-height: 1.8;
                                        color: #64748b;
                                    "
                                >
                                    If you initiated this change, you can safely
                                    ignore this email. No further action is
                                    required.
                                </p>

                                <!-- Signature -->
                                <div
                                    style="
                                        margin-top: 34px;
                                        padding-top: 24px;
                                        border-top: 1px solid #e2e8f0;
                                    "
                                >
                                    <p
                                        style="
                                            margin: 0 0 4px;
                                            font-size: 15px;
                                            line-height: 1.6;
                                            color: #475569;
                                        "
                                    >
                                        Stay safe,
                                    </p>
                                    <p
                                        style="
                                            margin: 0;
                                            font-size: 16px;
                                            font-weight: 700;
                                            color: #0f172a;
                                        "
                                    >
                                        The PH Healthcare System Security Team
                                    </p>
                                </div>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td
                                class="footer"
                                align="center"
                                style="
                                    padding: 28px 30px;
                                    background-color: #f8fafc;
                                    border-top: 1px solid #e2e8f0;
                                    text-align: center;
                                "
                            >
                                <p
                                    style="
                                        margin: 0 0 8px;
                                        font-size: 13px;
                                        line-height: 1.6;
                                        color: #94a3b8;
                                    "
                                >
                                    Need assistance? Contact us at
                                    <a
                                        href="mailto:support@ph-healthcare.com"
                                        style="
                                            color: #0284c7;
                                            text-decoration: none;
                                            font-weight: 600;
                                        "
                                        >support@ph-healthcare.com</a
                                    >
                                </p>
                                <p
                                    style="
                                        margin: 0;
                                        font-size: 12px;
                                        line-height: 1.6;
                                        color: #94a3b8;
                                    "
                                >
                                    &copy; <%= new Date().getFullYear() %> PH
                                    Healthcare System. All rights reserved.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
