<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="x-apple-disable-message-reformatting" />

        <title>BUS SHEBA - Ticket Confirmation</title>

        <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0 !important;
                padding: 0 !important;
                width: 100% !important;
                background-color: #f1f5f9;
                font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                -webkit-font-smoothing: antialiased;
            }

            table {
                border-spacing: 0;
                border-collapse: collapse;
            }

            img {
                border: 0;
                max-width: 100%;
                height: auto;
            }

            @media only screen and (max-width: 640px) {
                .email-wrapper {
                    padding: 20px 10px !important;
                }

                .email-container {
                    width: 100% !important;
                    max-width: 100% !important;
                    border-radius: 16px !important;
                }

                .header {
                    padding: 32px 20px 30px !important;
                }

                .header-title {
                    font-size: 24px !important;
                }

                .header-subtitle {
                    font-size: 14px !important;
                }

                .header-icon {
                    width: 58px !important;
                    height: 58px !important;
                    line-height: 58px !important;
                    font-size: 28px !important;
                }

                .content {
                    padding: 30px 20px !important;
                }

                .content-title {
                    font-size: 22px !important;
                }

                .content-text {
                    font-size: 15px !important;
                    line-height: 1.7 !important;
                }

                .card {
                    padding: 20px 16px !important;
                }

                .footer {
                    padding: 22px 16px !important;
                }
            }

            @media only screen and (max-width: 400px) {
                .email-wrapper {
                    padding: 10px 5px !important;
                }

                .email-container {
                    border-radius: 12px !important;
                }

                .header {
                    padding: 28px 16px !important;
                }

                .header-title {
                    font-size: 21px !important;
                }

                .content {
                    padding: 25px 16px !important;
                }

                .content-title {
                    font-size: 20px !important;
                }

                .content-text {
                    font-size: 14px !important;
                }

                .card {
                    padding: 18px 14px !important;
                }
            }
        </style>
    </head>

    <body>
        <table
            role="presentation"
            width="100%"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="width: 100%; background-color: #f1f5f9"
        >
            <tr>
                <td
                    class="email-wrapper"
                    align="center"
                    style="padding: 40px 15px"
                >
                    <!-- Main Container -->
                    <table
                        role="presentation"
                        class="email-container"
                        width="620"
                        cellpadding="0"
                        cellspacing="0"
                        border="0"
                        style="
                            width: 100%;
                            max-width: 620px;
                            background-color: #ffffff;
                            border: 1px solid #e2e8f0;
                            border-radius: 20px;
                            overflow: hidden;
                            box-shadow: 0 12px 35px rgba(15, 23, 42, 0.12);
                        "
                    >
                        <!-- Header -->
                        <tr>
                            <td
                                class="header"
                                align="center"
                                style="
                                    padding: 42px 30px 38px;
                                    background-color: #0f766e;
                                    background-image: linear-gradient(
                                        135deg,
                                        #0f766e 0%,
                                        #0891b2 50%,
                                        #2563eb 100%
                                    );
                                    color: #ffffff;
                                "
                            >
                                <div
                                    class="header-icon"
                                    style="
                                        width: 64px;
                                        height: 64px;
                                        line-height: 64px;
                                        margin: 0 auto 18px;
                                        background-color: rgba(255, 255, 255, 0.18);
                                        border: 2px solid rgba(255, 255, 255, 0.4);
                                        border-radius: 18px;
                                        font-size: 30px;
                                        font-weight: bold;
                                        color: #ffffff;
                                    "
                                >
                                    🎫
                                </div>

                                <h1
                                    class="header-title"
                                    style="
                                        margin: 0;
                                        font-size: 28px;
                                        line-height: 1.3;
                                        font-weight: 700;
                                        color: #ffffff;
                                    "
                                >
                                    BUS SHEBA
                                </h1>

                                <p
                                    class="header-subtitle"
                                    style="
                                        margin: 8px 0 0;
                                        font-size: 15px;
                                        line-height: 1.6;
                                        color: rgba(255, 255, 255, 0.9);
                                    "
                                >
                                    Bus Ticket Booking Platform
                                </p>
                            </td>
                        </tr>

                        <!-- Content Body -->
                        <tr>
                            <td class="content" style="padding: 42px 42px 35px; color: #334155">

                                <!-- Success Banner -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        margin-bottom: 28px;
                                        background-color: #ecfdf5;
                                        background-image: linear-gradient(135deg, #ecfdf5 0%, #eff6ff 100%);
                                        border: 1px solid #a7f3d0;
                                        border-radius: 16px;
                                    "
                                >
                                    <tr>
                                        <td class="card" align="center" style="padding: 24px 20px">
                                            <div
                                                style="
                                                    width: 48px;
                                                    height: 48px;
                                                    line-height: 48px;
                                                    margin: 0 auto 12px;
                                                    background-color: #059669;
                                                    border-radius: 50%;
                                                    color: #ffffff;
                                                    font-size: 24px;
                                                    font-weight: bold;
                                                "
                                            >
                                                ✓
                                            </div>

                                            <h2
                                                style="
                                                    margin: 0 0 6px;
                                                    font-size: 20px;
                                                    line-height: 1.4;
                                                    color: #047857;
                                                    font-weight: 700;
                                                "
                                            >
                                                Booking Confirmed 🎉
                                            </h2>

                                            <p
                                                class="content-text"
                                                style="
                                                    margin: 0;
                                                    font-size: 14px;
                                                    line-height: 1.6;
                                                    color: #065f46;
                                                "
                                            >
                                                Your bus ticket has been successfully booked.
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Ticket & Booking Information -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        margin-bottom: 24px;
                                        background-color: #f8fafc;
                                        border: 1px solid #e2e8f0;
                                        border-radius: 14px;
                                    "
                                >
                                    <tr>
                                        <td class="card" style="padding: 22px">
                                            <h3 style="margin: 0 0 14px; font-size: 16px; color: #0f172a; font-weight: 700;">
                                                Ticket Information
                                            </h3>
                                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                                <tr>
                                                    <td style="padding: 6px 0; font-size: 14px; color: #64748b;">Ticket Number:</td>
                                                    <td align="right" style="padding: 6px 0; font-size: 14px; font-weight: 600; color: #0f172a;">
                                                        <%= ticket.ticketNumber.slice(0, 8) %>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 6px 0; font-size: 14px; color: #64748b;">Booking Number:</td>
                                                    <td align="right" style="padding: 6px 0; font-size: 14px; font-weight: 600; color: #0f172a;">
                                                        <%= booking.bookingNumber %>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Passenger Information -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        margin-bottom: 24px;
                                        background-color: #f8fafc;
                                        border: 1px solid #e2e8f0;
                                        border-radius: 14px;
                                    "
                                >
                                    <tr>
                                        <td class="card" style="padding: 22px">
                                            <h3 style="margin: 0 0 16px; font-size: 16px; color: #0f172a; font-weight: 700;">
                                                Passenger Information
                                            </h3>

                                            <% booking.passengers.forEach((passenger, index) => { %>
                                                <div style="<%= index > 0 ? 'margin-top: 18px; padding-top: 18px; border-top: 1px dashed #cbd5e1;' : '' %>">
                                                    <div style="font-size: 14px; font-weight: 700; color: #0f766e; margin-bottom: 8px;">
                                                        Passenger <%= index + 1 %>
                                                    </div>
                                                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                                        <tr>
                                                            <td style="padding: 4px 0; font-size: 14px; color: #64748b;">Name:</td>
                                                            <td align="right" style="padding: 4px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= passenger.name %></td>
                                                        </tr>
                                                        <tr>
                                                            <td style="padding: 4px 0; font-size: 14px; color: #64748b;">Phone:</td>
                                                            <td align="right" style="padding: 4px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= passenger.phone %></td>
                                                        </tr>
                                                        <% if (passenger.email) { %>
                                                            <tr>
                                                                <td style="padding: 4px 0; font-size: 14px; color: #64748b;">Email:</td>
                                                                <td align="right" style="padding: 4px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= passenger.email %></td>
                                                            </tr>
                                                        <% } %>
                                                        <% const bookingSeat = bookingSeats[index]; %>
                                                        <% if (bookingSeat) { %>
                                                            <tr>
                                                                <td style="padding: 4px 0; font-size: 14px; color: #64748b;">Seat:</td>
                                                                <td align="right" style="padding: 4px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= bookingSeat.tripSeat.seat.seatNumber %></td>
                                                            </tr>
                                                            <tr>
                                                                <td style="padding: 4px 0; font-size: 14px; color: #64748b;">Seat Price:</td>
                                                                <td align="right" style="padding: 4px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= bookingSeat.price %> BDT</td>
                                                            </tr>
                                                        <% } %>
                                                    </table>
                                                </div>
                                            <% }); %>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Journey Information -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        margin-bottom: 24px;
                                        background-color: #f8fafc;
                                        border: 1px solid #e2e8f0;
                                        border-radius: 14px;
                                    "
                                >
                                    <tr>
                                        <td class="card" style="padding: 22px">
                                            <h3 style="margin: 0 0 14px; font-size: 16px; color: #0f172a; font-weight: 700;">
                                                Journey Information
                                            </h3>
                                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Bus:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= booking.trip.bus.name %></td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Registration No:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= booking.trip.bus.registrationNo %></td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Operator:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= booking.trip.bus.operator.companyName %></td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Route:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;">
                                                        <%= booking.trip.route.source %> → <%= booking.trip.route.destination %>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Boarding Point:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= booking.fromStop.stopName %></td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Destination:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= booking.toStop.stopName %></td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Travel Date:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= new Date(booking.trip.travelDate).toDateString() %></td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Departure Time:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= new Date(booking.trip.departureTime).toLocaleTimeString() %></td>
                                                </tr>
                                            </table>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Seat Breakdown Summary -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        margin-bottom: 24px;
                                        background-color: #f8fafc;
                                        border: 1px solid #e2e8f0;
                                        border-radius: 14px;
                                    "
                                >
                                    <tr>
                                        <td class="card" style="padding: 22px">
                                            <h3 style="margin: 0 0 14px; font-size: 16px; color: #0f172a; font-weight: 700;">
                                                Seat Information
                                            </h3>
                                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                                <% bookingSeats.forEach((bookingSeat, index) => { %>
                                                    <tr>
                                                        <td style="padding: 5px 0; font-size: 14px; color: #64748b;">
                                                            Seat <%= index + 1 %> (<%= bookingSeat.tripSeat.seat.seatNumber %>)
                                                        </td>
                                                        <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;">
                                                            <%= bookingSeat.price %> BDT
                                                        </td>
                                                    </tr>
                                                <% }); %>
                                            </table>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Payment Information -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        margin-bottom: 28px;
                                        background-color: #f8fafc;
                                        border: 1px solid #e2e8f0;
                                        border-radius: 14px;
                                    "
                                >
                                    <tr>
                                        <td class="card" style="padding: 22px">
                                            <h3 style="margin: 0 0 14px; font-size: 16px; color: #0f172a; font-weight: 700;">
                                                Payment Information
                                            </h3>
                                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Total Amount:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 16px; font-weight: 700; color: #059669;">
                                                        <%= booking.totalAmount %> BDT
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Payment Method:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= payment.provider %></td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Transaction ID:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;"><%= payment.trxID %></td>
                                                </tr>
                                                <tr>
                                                    <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Payment Status:</td>
                                                    <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #059669;"><%= payment.status %></td>
                                                </tr>
                                                <% if (payment.paidAt) { %>
                                                    <tr>
                                                        <td style="padding: 5px 0; font-size: 14px; color: #64748b;">Paid At:</td>
                                                        <td align="right" style="padding: 5px 0; font-size: 14px; font-weight: 600; color: #0f172a;">
                                                            <%= new Date(payment.paidAt).toLocaleString() %>
                                                        </td>
                                                    </tr>
                                                <% } %>
                                            </table>
                                        </td>
                                    </tr>
                                </table>

                                <!-- CTA Action Button -->
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 32px 0 28px;">
                                    <tr>
                                        <td align="center">
                                            <a
                                                href="<%= ticketPdfUrl %>"
                                                target="_blank"
                                                style="
                                                    display: inline-block;
                                                    padding: 16px 36px;
                                                    background-color: #0f766e;
                                                    background-image: linear-gradient(135deg, #0f766e 0%, #0891b2 100%);
                                                    color: #ffffff;
                                                    text-decoration: none;
                                                    border-radius: 12px;
                                                    font-weight: 700;
                                                    font-size: 15px;
                                                    box-shadow: 0 4px 14px rgba(15, 118, 110, 0.35);
                                                "
                                            >
                                                View / Download Ticket
                                            </a>
                                        </td>
                                    </tr>
                                </table>

                                <!-- QR / Verification Box -->
                                <table
                                    role="presentation"
                                    width="100%"
                                    cellpadding="0"
                                    cellspacing="0"
                                    border="0"
                                    style="
                                        width: 100%;
                                        background-color: #f0f9ff;
                                        border-left: 4px solid #0284c7;
                                        border-radius: 8px;
                                    "
                                >
                                    <tr>
                                        <td class="card" align="center" style="padding: 20px 18px">
                                            <p style="margin: 0 0 6px; font-size: 15px; font-weight: 700; color: #0f172a;">
                                                🔒 Ticket Verification
                                            </p>
                                            <p class="content-text" style="margin: 0 0 6px; font-size: 14px; line-height: 1.6; color: #475569;">
                                                Show the QR code from your PDF ticket when boarding.
                                            </p>
                                            <p style="margin: 0; font-size: 13px; font-weight: 600; color: #0284c7;">
                                                Ticket Ref: <%= ticket.ticketNumber.slice(0, 8) %>
                                            </p>
                                        </td>
                                    </tr>
                                </table>

                                <!-- Signature -->
                                <div
                                    style="
                                        margin-top: 34px;
                                        padding-top: 24px;
                                        border-top: 1px solid #e2e8f0;
                                    "
                                >
                                    <p
                                        class="content-text"
                                        style="
                                            margin: 0;
                                            font-size: 15px;
                                            line-height: 1.7;
                                            color: #475569;
                                        "
                                    >
                                        Thank you for choosing <strong>BUS SHEBA</strong>.<br />
                                        Safe travels on your journey!
                                    </p>
                                </div>
                            </td>
                        </tr>

                        <!-- Footer -->
                        <tr>
                            <td
                                class="footer"
                                align="center"
                                style="
                                    background-color: #f8fafc;
                                    border-top: 1px solid #e2e8f0;
                                    padding: 28px 20px;
                                    font-size: 13px;
                                    line-height: 1.6;
                                    color: #64748b;
                                "
                            >
                                <p style="margin: 0 0 6px;">
                                    Please keep this email and your ticket safe.
                                </p>
                                <p style="margin: 0;">
                                    © <%= new Date().getFullYear() %> BUS SHEBA. All rights reserved.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>
