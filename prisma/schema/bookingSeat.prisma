model BookingSeat {
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    bookingId String @db.Uuid

    tripSeatId String @unique @db.Uuid

    price Decimal @db.Decimal(10, 2)

    createdAt DateTime @default(now())

    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

    tripSeat TripSeat @relation(fields: [tripSeatId], references: [id], onDelete: Restrict)

    @@index([bookingId], name: "idx_booking_seat_booking_id")
    @@index([tripSeatId], name: "idx_booking_seat_tripSeat_id")
    @@map("booking_seats")
}
