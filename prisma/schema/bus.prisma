model Bus {
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    operatorId String @db.Uuid

    name           String @db.VarChar(100)
    registrationNo String @unique @db.VarChar(50)

    busType    BusType
    totalSeats Int

    status BusStatus @default(ACTIVE)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    operator Operator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
    seats    Seat[]
    trips    Trip[]

    @@index([operatorId], name: "idx_operator_id")
    @@map("buses")
}
