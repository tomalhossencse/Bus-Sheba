model Trip {
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    busId   String @db.Uuid
    routeId String @db.Uuid

    travelDate DateTime @db.Date

    departureTime DateTime
    arrivalTime   DateTime

    fare Decimal @db.Decimal(10, 2)

    status TripStatus @default(SCHEDULED)

    bus Bus @relation(fields: [busId], references: [id], onDelete: Restrict)

    route Route @relation(fields: [routeId], references: [id], onDelete: Restrict)

    tripSeats TripSeat[]
    bookings  Booking[]
    reviews   Review[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([routeId, travelDate, departureTime], name: "unique_trip_per_route_per_day")
    @@unique([busId, travelDate, departureTime], name: "unique_trip_per_bus_per_day")
    @@index([busId], name: "idx_busId")
    @@index([routeId], name: "idx_routeId")
    @@index([travelDate], name: "idx_travelDate")
    @@index([status], name: "idx_status")
    @@map("trips")
}
