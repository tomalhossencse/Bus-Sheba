model Operator {
    id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

    userId String @unique @db.Uuid
    name   String @db.VarChar(100)
    email  String @unique @db.VarChar(255)

    companyName   String  @db.VarChar(150)
    contactPerson String? @db.VarChar(100)
    phone         String? @db.VarChar(20)
    address       String?

    // Business Information
    nidNumber              String? @db.VarChar(50)
    tradeLicenseNo         String? @unique @db.VarChar(100)
    businessRegistrationNo String? @unique @db.VarChar(100)
    taxIdentificationNo    String? @db.VarChar(50)

    // Verification Documents
    nidDocument String?
    nidPublicId String?

    tradeLicenseDocument String?
    tradeLicensePublicId String?

    businessRegistrationDocument String?
    businessRegistrationPublicId String?

    taxCertificateDocument String?
    taxCertificatePublicId String?

    additionalDocuments Json?

    verificationStatus OperatorVerificationStatus @default(PENDING)
    reviewedAt         DateTime?
    reviewedById       String?                    @db.Uuid
    rejectionReason    String?

    // relations

    user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    reviewedBy User? @relation("AdminReviewer", fields: [reviewedById], references: [id])

    buses Bus[]

    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([email], name: "idx_operator_email")
    @@index([isDeleted], name: "idx_operator_isDeleted")
    @@map("operators")
}
