# =============================================================================
# Bus Sheba - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file or these secrets to the repository.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Base URLs
BACKEND_URL=http://localhost:5000
# Allowed CORS origin for the frontend browser client
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bus_sheba?schema=public"

# -----------------------------------------------------------------------------
# JWT (generate strong random secrets, e.g. `openssl rand -hex 64`)
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-me
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-me
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Redis (required at startup; used for OTP rate-limit / token caching)
# -----------------------------------------------------------------------------
RADIS_USERNAME=default
RADIS_PASSWORD=your-redis-password
RADIS_HOST=localhost
RADIS_PORT=6379

# -----------------------------------------------------------------------------
# SMTP / Email (Nodemailer uses Gmail service)
# Use an app password, never your real Gmail password
# -----------------------------------------------------------------------------
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your-smtp-app-password
EMAIL_SENDER="Bus Sheba <youremail@gmail.com>"

# -----------------------------------------------------------------------------
# Cloudinary (profile images + ticket PDF storage)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_API_KEY=your-api-key
CLOUDINARY_CLOUD_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# bKash (sandbox = https://tokenized.sandbox.bka.sh, live = https://tokenized.pay.bka.sh)
# -----------------------------------------------------------------------------
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
# Must be a publicly reachable URL: /api/v1/payment/callback is appended
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payment

# -----------------------------------------------------------------------------
# Seed credentials (created automatically on server start)
# -----------------------------------------------------------------------------
# Super Admin
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=StrongPass@123

# Tester Admin
TESTER_ADMIN_NAME=Tester Admin
TESTER_ADMIN_EMAIL=admin@example.com
TESTER_ADMIN_PASSWORD=StrongPass@123

# Tester Operator
TESTER_OPERATOR_NAME=Tester Operator
TESTER_OPERATOR_EMAIL=operator@example.com
TESTER_OPERATOR_PASSWORD=StrongPass@123

